# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run on mock data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Optional: only needed for private datasets.
SANITY_API_READ_TOKEN=
# Mux credentials are entered inside Studio (sanity-plugin-mux-input stores them in the dataset), not here.
